# 로컬 개발용 환경변수 예시. 이 파일을 .env로 복사해 값을 채운다.
# 배포 환경에서는 컨테이너 환경변수로 주입되며(docker-entrypoint.sh → window.__ENV__),
# VITE_ 접두사가 붙은 변수만 앱에 전달된다.

VITE_APP_ENV=development

# SEED+ 백엔드(Spring)
VITE_DEV_API_BASE_URL=http://<dev-host>:18080
# VITE_PROD_API_BASE_URL=

# 상권날씨 AI(FastAPI) — 백엔드를 거치지 않고 FE가 직접 호출한다.
#
# 로컬: AI 서버에 CORS 미들웨어가 없어 브라우저 직접 호출이 차단되므로
#       vite 프록시(/ai)를 경유한다. 아래 값을 그대로 쓰면 된다.
#       AI 서버 실행: python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000
#       포트가 다르면 AI_API_PROXY_TARGET=http://localhost:<port> 로 vite를 실행한다.
# 배포: 인프라가 주입한다. prod는 Nginx 프록시로 same-origin(https://www.seedplusai.com/ai/)이라
#       CORS 설정이 필요 없다. dev는 http://<dev-host>:8000/ 를 직접 호출한다.
VITE_DEV_AI_API_BASE_URL=/ai
# VITE_PROD_AI_API_BASE_URL=

# GA4 (프로덕션에만 주입)
# VITE_GA_MEASUREMENT_ID=
